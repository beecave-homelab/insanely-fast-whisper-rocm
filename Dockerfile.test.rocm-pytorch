# syntax=docker/dockerfile:1

# ROCm PyTorch route — uses the official rocm/pytorch base image which
# already includes PyTorch built against ROCm.  Only app-level deps and
# the test entrypoint are layered on top.
#
# Build:  docker compose -f docker-compose.test.rocm-routes.yaml build \
#           insanely-fast-whisper-rocm-test-rocm-pytorch
# Run:    docker compose -f docker-compose.test.rocm-routes.yaml run --rm \
#           insanely-fast-whisper-rocm-test-rocm-pytorch

ARG ROCM_PYTORCH_BASE=rocm/pytorch:rocm7.0_ubuntu22.04_py3.10_pytorch_release_2.8.0
FROM ${ROCM_PYTORCH_BASE}

LABEL org.opencontainers.image.source https://github.com/beecave-homelab/insanely-fast-whisper-rocm
LABEL org.opencontainers.image.description "ROCm PyTorch route test container"

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PIP_NO_CACHE_DIR=off
ENV TZ=Europe/Amsterdam
ENV ROCM_PATH=/opt/rocm
ENV HSA_OVERRIDE_GFX_VERSION=10.3.0
# Skip MIOpen JIT kernel compilation — Mode 2 = database-only (no JIT).
ENV MIOPEN_FIND_MODE=2

# Install OS-level deps needed for audio backends + curl for API tests
RUN apt-get update -y && apt-get upgrade -y && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

WORKDIR /app

# Copy requirement files first (for layer caching)
COPY requirements-all.txt /app/

# Install project dependencies from requirements-all.txt.
# The rocm/pytorch base image already provides torch + torchaudio, so
# we let pip skip them if they are already satisfied.
RUN pip install --no-cache-dir -r requirements-all.txt
RUN pip uninstall -y torchcodec 2>/dev/null || true

# Copy project metadata and source
COPY pyproject.toml /app/
COPY openapi.yaml /app/
COPY ./insanely_fast_whisper_rocm /app/insanely_fast_whisper_rocm/

# Install the local package (no-deps: dependencies already installed above)
RUN pip install -U pip
RUN pip install --no-cache-dir --no-deps .

ENV GRADIO_SERVER_NAME="0.0.0.0"
ENV TORCHAUDIO_USE_SOUNDFILE=1

EXPOSE 8891
EXPOSE 7864

# Copy the test entrypoint and diagnostics scripts
COPY scripts/entrypoint-test.sh /app/entrypoint-test.sh
COPY scripts/entrypoint-test-rocm-diagnostics.sh /app/entrypoint-test-rocm-diagnostics.sh
RUN chmod +x /app/entrypoint-test.sh /app/entrypoint-test-rocm-diagnostics.sh

CMD ["/app/entrypoint-test.sh"]
